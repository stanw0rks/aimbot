    -- FOV Circle (Aimbot)
    if aimbotOn then
        local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        local diameter = FOV_RADIUS * 2
        -- Draw FOV circle logic here if needed
        
        -- Aimbot Logic
        local char = LOCAL_PLAYER.Character
        local hasWeapon = char and char:FindFirstChildOfClass("Tool")
        local isZoomed = Camera.FieldOfView < (normalFOV - 1)
        
        if hasWeapon and isZoomed then
            if not isAiming or not currentTarget or not currentTarget.Character then
                currentTarget = nil
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LOCAL_PLAYER and p.Character and p.Character:FindFirstChild("Head") then
                        local headPos = p.Character.Head.Position
                        local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
                        if onScreen and (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude <= FOV_RADIUS then
                            currentTarget = p
                            break
                        end
                    end
                end
            end
            if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild("Head") then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, currentTarget.Character.Head.Position)
            end
        end
    end
    
    -- Hitbox Logic
    if hitboxOn then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LOCAL_PLAYER and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = p.Character.HumanoidRootPart
                hrp.Size = Vector3.new(currentSize, currentSize, currentSize)
                hrp.Transparency = 0.8
                hrp.Color = Color3.fromRGB(255, 105, 180)
                hrp.CanCollide = false
            end
        end
    end
end)

