-- Toggle Functions
local function toggleAimbot()
    aimbotOn = not aimbotOn
    aimbotToggle.Text = aimbotOn and "POWER AIMBOT (ON)" or "POWER AIMBOT (OFF)"
    aimbotToggle.BackgroundColor3 = aimbotOn and Color3.fromRGB(255, 20, 147) or Color3.fromRGB(255, 105, 180)
    if not aimbotOn then currentTarget = nil; isAiming = false end
end

local function toggleHitbox()
    hitboxOn = not hitboxOn
    hitboxToggle.Text = hitboxOn and "PINK HITBOX (ON)" or "PINK HITBOX (OFF)"
    hitboxToggle.BackgroundColor3 = hitboxOn and Color3.fromRGB(255, 20, 147) or Color3.fromRGB(255, 105, 180)
end

local function toggleNoHold()
    noHoldOn = not noHoldOn
    noHoldToggle.Text = noHoldOn and "NO HOLD PROMPTS (ON)" or "NO HOLD PROMPTS (OFF)"
    noHoldToggle.BackgroundColor3 = noHoldOn and Color3.fromRGB(255, 20, 147) or Color3.fromRGB(255, 105, 180)
    if noHoldOn then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then obj.HoldDuration = 0 end
        end
        workspace.DescendantAdded:Connect(function(obj)
            if obj:IsA("ProximityPrompt") then obj.HoldDuration = 0 end
        end)
    end
end

