local uiVisible = true
local function toggleUI()
    uiVisible = not uiVisible
    win.Visible = uiVisible
    if not uiVisible then fovCircle.Visible = false else fovCircle.Visible = aimEnabled end
end

UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if rebinding then
        pending[rebinding] = input.KeyCode
        if rebinding=="hide" then hideBtn.Text=input.KeyCode.Name else showBtn.Text=input.KeyCode.Name end
        rebinding = nil return
    end
    if input.KeyCode == Enum.KeyCode.L then toggleUI() end
    if input.KeyCode == binds.hide then Inventory:FireServer("Change","Glock-17","Inv") end
    if input.KeyCode == binds.show then Inventory:FireServer("Change","Glock-17","Backpack") end
end)
closeBtn.MouseButton1Click:Connect(toggleUI)
if mobileBtn then mobileBtn.MouseButton1Click:Connect(toggleUI) end
