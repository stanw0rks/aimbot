-- Toggle Functions
local function toggleAimbot()
    aimbotOn = not aimbotOn
    aimbotBtn.Text = aimbotOn and "🎯 POWER AIMBOT (ON)" or "🎯 POWER AIMBOT (OFF)"
    aimbotBtn.BackgroundColor3 = aimbotOn and Color3.fromRGB(255, 20, 147) or Color3.fromRGB(255, 105, 180)
    FOV_RADIUS = tonumber(fovBox.Text) or 220
end

local function toggleHitbox()
    hitboxOn = not hitboxOn
    hitboxBtn.Text = hitboxOn and "💖 PINK HITBOX (ON)" or "💖 PINK HITBOX (OFF)"
    hitboxBtn.BackgroundColor3 = hitboxOn and Color3.fromRGB(255, 20, 147) or Color3.fromRGB(255, 105, 180)
    currentSize = tonumber(sizeBox.Text) or 10
end

local function toggleNoHold()
    noHoldOn = not noHoldOn
    noholdBtn.Text = noHoldOn and "⚡ NO HOLD PROMPTS (ON)" or "⚡ NO HOLD PROMPTS (OFF)"
    noholdBtn.BackgroundColor3 = noHoldOn and Color3.fromRGB(255, 20, 147) or Color3.fromRGB(255, 105, 180)
    
    if noHoldOn then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                obj.HoldDuration = 0
            end
        end
        connections.nohold = workspace.DescendantAdded:Connect(function(obj)
            if obj:IsA("ProximityPrompt") then
                obj.HoldDuration = 0
            end
        end)
    else
        if connections.nohold then connections.nohold:Disconnect() end
    end
end

