local tabBtns  = {}
local tabPages = {}
local activeTab = nil

local function switchTab(name)
    for n, page in pairs(tabPages) do
        page.Visible = (n == name)
    end
    for n, btn in pairs(tabBtns) do
        if n == name then
            tw(btn, {BackgroundColor3=DEEP_PINK,  TextColor3=WHITE},      0.15)
        else
            tw(btn, {BackgroundColor3=Color3.fromRGB(55,25,45), TextColor3=LIGHT_PINK}, 0.15)
        end
    end
    activeTab = name
end

local function AddTab(name)
    local tb = Instance.new("TextButton")
    tb.Size             = UDim2.new(0,68,0,26)
    tb.BackgroundColor3 = Color3.fromRGB(55,25,45)
    tb.Text             = name
    tb.TextColor3       = LIGHT_PINK
    tb.TextSize         = 10
    tb.Font             = Enum.Font.GothamBold
    tb.AutoButtonColor  = false
    tb.Parent           = tabBar
    mkCorner(tb, 6)

    local page = Instance.new("ScrollingFrame")
    page.Size                = UDim2.new(1,0,1,0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel     = 0
    page.ScrollBarThickness  = 3
    page.ScrollBarImageColor3= PINK
    page.CanvasSize          = UDim2.new(0,0,0,0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible             = false
    page.Parent              = contentArea

    local layout = Instance.new("UIListLayout")
    layout.Padding              = UDim.new(0,8)
    layout.HorizontalAlignment  = Enum.HorizontalAlignment.Center
    layout.Parent               = page

    local pad = Instance.new("UIPadding")
    pad.PaddingTop    = UDim.new(0,10)
    pad.PaddingBottom = UDim.new(0,10)
    pad.Parent        = page

    tabBtns[name]  = tb
    tabPages[name] = page
    tb.MouseButton1Click:Connect(function() switchTab(name) end)
    if not activeTab then switchTab(name) end
    return page
end

