})

local ppOn = false
local ppToggle = Instance.new("TextButton")
ppToggle.Size             = UDim2.new(0,90,0,30)
ppToggle.Position         = UDim2.new(1,-100,0.5,-15)
ppToggle.BackgroundColor3 = Color3.fromRGB(80,25,60)
ppToggle.Text             = "OFF"
ppToggle.TextColor3       = LIGHT_PINK
ppToggle.TextSize         = 12
ppToggle.Font             = Enum.Font.GothamBold
ppToggle.AutoButtonColor  = false
ppToggle.Parent           = ppCard
corner(ppToggle, 8)
stroke(ppToggle, PINK, 1)

-- ════════════════════════════
--  LOGIC: Proximity Prompt
-- ════════════════════════════
local ppConnection = nil

local function removeHold(prompt)
    if prompt:IsA("ProximityPrompt") then
        prompt.HoldDuration = 0
    end
end

ppToggle.MouseButton1Click:Connect(function()
    ppOn = not ppOn
    if ppOn then
        tween(ppToggle, { BackgroundColor3 = DEEP_PINK, TextColor3 = WHITE }, 0.15)
        ppToggle.Text = "ON"
        for _, obj in ipairs(workspace:GetDescendants()) do
            removeHold(obj)
        end
        ppConnection = workspace.DescendantAdded:Connect(removeHold)
    else
        tween(ppToggle, { BackgroundColor3 = Color3.fromRGB(80,25,60), TextColor3 = LIGHT_PINK }, 0.15)
        ppToggle.Text = "OFF"
        if ppConnection then
            ppConnection:Disconnect()
            ppConnection = nil
        end
    end
end)

-- ════════════════════════════
--  LOGIC: Keybind rebind
-- ════════════════════════════
local function setRebind(btn, which)
    rebinding = which
    btn.Text       = "[ Press ]"
    btn.TextColor3 = Color3.fromRGB(255, 230, 80)
    tween(btn, { BackgroundColor3 = Color3.fromRGB(60,45,10) }, 0.1)
end

hideBtn.MouseButton1Click:Connect(function() setRebind(hideBtn, "hide") end)
showBtn.MouseButton1Click:Connect(function() setRebind(showBtn, "show") end)

saveRow.MouseButton1Click:Connect(function()
    binds.hide = pending.hide
    binds.show = pending.show
    tween(saveRow, { BackgroundColor3 = Color3.fromRGB(30,80,40) }, 0.1)
    saveRow.Text = "✓  Saved!"
    task.delay(1.2, function()
        tween(saveRow, { BackgroundColor3 = DEEP_PINK }, 0.2)
        saveRow.Text = "✓  Save Keybinds"
    end)
end)

-- ════════════════════════════
--  TOGGLE UI VISIBILITY
-- ════════════════════════════
local uiVisible = true  -- starts visible

local function toggleUI()
    uiVisible = not uiVisible
    if uiVisible then
        win.Visible = true
        win.BackgroundTransparency = 1
        tween(win, { BackgroundTransparency = 0 }, 0.25)
    else
        tween(win, { BackgroundTransparency = 1 }, 0.2)
        task.delay(0.22, function() win.Visible = false end)
    end
end

closeBtn.MouseButton1Click:Connect(function()
    uiVisible = true
    toggleUI()
end)

if IS_MOBILE and mobileBtn then
    mobileBtn.MouseButton1Click:Connect(function()
        toggleUI()
    end)
end

-- ════════════════════════════
--  INPUT (PC)
-- ════════════════════════════
if not IS_MOBILE then
    UIS.InputBegan:Connect(function(input, gpe)
        if gpe then return end

        if rebinding then
            local kc = input.KeyCode
            if kc ~= Enum.KeyCode.Unknown and kc ~= Enum.KeyCode.Escape then
                pending[rebinding] = kc
                if rebinding == "hide" then
                    hideBtn.Text       = kc.Name
                    hideBtn.TextColor3 = WHITE
                    tween(hideBtn, { BackgroundColor3 = DEEP_PINK }, 0.1)
                else
                    showBtn.Text       = kc.Name
                    showBtn.TextColor3 = WHITE
                    tween(showBtn, { BackgroundColor3 = DEEP_PINK }, 0.1)
                end
                rebinding = nil
            end
            return
        end

        if input.KeyCode == Enum.KeyCode.L then
            toggleUI()
            return
        end

        if input.KeyCode == binds.hide then
            Inventory:FireServer("Change", "Glock-17", "Inv")
        elseif input.KeyCode == binds.show then
            Inventory:FireServer("Change", "Glock-17", "Backpack")
        end
    end)
end

