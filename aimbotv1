local function mkCorner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = p
    return c
end

local function mkStroke(p, col, thick)
    local s = Instance.new("UIStroke")
    s.Color     = col   or PINK
    s.Thickness = thick or 1.5
    s.Parent    = p
    return s
end

local function tw(obj, props, t, style)
    TS:Create(obj, TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quart), props):Play()
end

local function mkLabel(parent, text, size, color, font, props)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text       = text
    l.TextSize   = size  or 12
    l.TextColor3 = color or WHITE
    l.Font       = font  or Enum.Font.GothamSemibold
    l.Parent     = parent
    if props then for k,v in pairs(props) do l[k]=v end end
    return l
end

local function mkDrag(frame, handle)
    handle = handle or frame
    local drag, dragIn, mPos, fPos = false,nil,nil,nil
    handle.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            drag=true mPos=i.Position fPos=frame.Position
            i.Changed:Connect(function()
                if i.UserInputState==Enum.UserInputState.End then drag=false end
            end)
        end
    end)
    handle.InputChanged:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then
            dragIn=i
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if i==dragIn and drag then
            local d=i.Position-mPos
            frame.Position=UDim2.new(fPos.X.Scale,fPos.X.Offset+d.X,fPos.Y.Scale,fPos.Y.Offset+d.Y)
        end
    end)
end

